# Copy this file to .streamlit/secrets.toml for local development.
# For the deployed app, paste the same contents into the Streamlit Cloud
# secrets editor (Settings -> Secrets).
#
# secrets.toml is gitignored — never commit real credentials.

# Shared password to access the app.
APP_PASSWORD = "change-me-to-a-long-random-string"

# Full URL of the Google Sheet that stores records.
sheet_url = "https://docs.google.com/spreadsheets/d/REPLACE_WITH_SHEET_ID/edit"

# Paste the JSON of your Google service account key here, converted to TOML.
# Easiest way: open the downloaded JSON, then fill the fields below.
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
# Keep the literal \n inside the quotes — TOML preserves them and gspread expects them.
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"
